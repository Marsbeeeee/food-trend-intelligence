{
  "schema": "benchmark_review_v1",
  "selection": "human_review",
  "decisions": [
    "pending",
    "selected",
    "reserve",
    "rejected"
  ],
  "fit_categories": [
    "direct",
    "adjacent",
    "unverified"
  ],
  "automatic_ranking": false,
  "exclude_for_low_recent_views": false,
  "comparison": {
    "group_by": [
      "account_id",
      "platform",
      "format"
    ],
    "metric": "views",
    "baseline": "median_of_explicit_baseline_sample",
    "minimum_numeric_sample": 10,
    "content_groups": "human_assigned_ordinary_or_high",
    "fallback_metric": null,
    "cross_platform_score": false
  }
}

